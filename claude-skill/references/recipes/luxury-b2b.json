{
  "name": "luxury-b2b",
  "description": "Premium B2B corporate — cinematic filter, subtitles, vignette, slow zoom, elegant title. v0.4 spec.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "operations": [
    {
      "id": "main",
      "op": "add_video",
      "args": { "file": "{{VIDEO_FILE}}", "track": "V1", "start": "0s", "duration": "auto" }
    },
    {
      "op": "add_filter",
      "args": { "name": "cinematic", "start": "0s", "duration": "auto", "intensity": 0.45 }
    },
    {
      "op": "add_effect",
      "args": { "name": "vignette", "start": "0s", "duration": "auto" }
    },
    {
      "op": "add_color_adjust",
      "args": {
        "track": "V1", "segment_ref": "main",
        "brightness": -0.03, "contrast": 0.12, "saturation": -0.08, "temperature": -0.03
      }
    },
    {
      "op": "add_video_animation",
      "args": { "track": "V1", "segment_ref": "main", "role": "intro", "name": "fade_in", "duration": "1s" }
    },
    {
      "op": "add_keyframe",
      "args": { "track": "V1", "segment_ref": "main", "property": "uniform_scale", "time": "0s", "value": 1.0 }
    },
    {
      "op": "add_keyframe",
      "args": { "track": "V1", "segment_ref": "main", "property": "uniform_scale", "time": "12s", "value": 1.06 }
    },
    {
      "id": "title",
      "op": "add_text",
      "args": {
        "text": "{{TITLE_TEXT}}",
        "track": "T1",
        "start": "1s",
        "duration": "4s",
        "style": "lifestyle-brand",
        "clip_settings": "title-center"
      }
    },
    {
      "op": "add_text_animation",
      "args": { "track": "T1", "segment_ref": "title", "role": "intro", "name": "fade_in", "duration": "0.8s" }
    },
    {
      "op": "add_text_animation",
      "args": { "track": "T1", "segment_ref": "title", "role": "outro", "name": "fade_out", "duration": "0.8s" }
    },
    {
      "op": "import_srt",
      "args": { "file": "{{SRT_FILE}}", "track": "T2", "style": "youtube-subtitle" }
    },
    {
      "id": "bgm",
      "op": "add_audio",
      "args": { "file": "{{AUDIO_FILE}}", "track": "A1", "start": "0s", "duration": "auto", "volume": 0.3 }
    },
    {
      "op": "add_audio_fade",
      "args": { "track": "A1", "segment_ref": "bgm", "fade_in": "1.5s", "fade_out": "2.5s" }
    }
  ]
}
